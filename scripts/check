#!/usr/bin/env bash
# The single gate: run by the pre-push hook and by CI. Fast checks first.
set -euo pipefail
cd "$(dirname "$0")/.."
npx tsc --noEmit
npx eslint .
npx jest --silent
npx next build
scripts/clean-code-audit   # report only; add --strict once the long functions in .claude/skills/*/scripts are split
